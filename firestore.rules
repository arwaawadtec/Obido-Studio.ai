rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection
    // Document ID is the Firebase Auth UID
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['id', 'email', 'name']) &&
          data.id is string && data.id.size() <= 128 &&
          data.email is string && data.email.size() <= 256 &&
          data.name is string && data.name.size() <= 128 &&
          data.id == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other user profiles

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().id == request.auth.uid;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email;

      allow delete: if isOwner(userId);
    }

    // Projects Collection
    match /projects/{projectId} {
      function isValidProject(data) {
        return data.keys().hasAll(['id', 'userId', 'title', 'createdAt']) &&
          data.id is string && data.id.size() <= 128 &&
          data.userId is string && data.userId.size() <= 128 &&
          data.title is string && data.title.size() <= 256;
      }

      function isProjectOwner(projectData) {
        return isSignedIn() && projectData.userId == request.auth.uid;
      }

      function hasEmailAccess(emailsList) {
        return isSignedIn() &&
          request.auth.token.email != null &&
          emailsList is list &&
          request.auth.token.email.lower() in emailsList;
      }

      function isProjectCollaborator(projectData) {
        return isProjectOwner(projectData) ||
          ('memberEmails' in projectData && hasEmailAccess(projectData.memberEmails));
      }

      function isProjectEditor(projectData) {
        return isProjectOwner(projectData) ||
          ('editorEmails' in projectData && hasEmailAccess(projectData.editorEmails));
      }

      allow get: if isProjectCollaborator(existing());
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.memberEmails is list && request.auth.token.email.lower() in resource.data.memberEmails)
      );

      allow create: if isSignedIn() &&
        isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().userId == request.auth.uid;

      allow update: if isSignedIn() &&
        isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId && (
          // Owner can update any project field including team members
          isProjectOwner(existing()) ||
          // Editor can update content but cannot alter ownership or members list
          (isProjectEditor(existing()) &&
           incoming().collaborators == existing().collaborators &&
           incoming().memberEmails == existing().memberEmails &&
           incoming().editorEmails == existing().editorEmails &&
           incoming().viewerEmails == existing().viewerEmails)
        );

      allow delete: if isProjectOwner(existing());
    }

    // Media Assets Metadata Collection
    match /assets/{assetId} {
      function isValidAsset(data) {
        return data.keys().hasAll(['id', 'projectId', 'userId', 'name', 'type']) &&
          data.id is string && data.id.size() <= 128 &&
          data.projectId is string && data.projectId.size() <= 128 &&
          data.userId is string && data.userId.size() <= 128 &&
          data.name is string && data.name.size() <= 256 &&
          data.type is string && data.type.size() <= 32;
      }

      function hasEmailAccess(emailsList) {
        return isSignedIn() &&
          request.auth.token.email != null &&
          emailsList is list &&
          request.auth.token.email.lower() in emailsList;
      }

      allow get: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        ('memberEmails' in existing() && hasEmailAccess(existing().memberEmails))
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.memberEmails is list && request.auth.token.email.lower() in resource.data.memberEmails)
      );

      allow create: if isSignedIn() &&
        isValidId(assetId) &&
        isValidAsset(incoming()) &&
        incoming().userId == request.auth.uid;

      allow update: if isSignedIn() &&
        isValidId(assetId) &&
        existing().userId == request.auth.uid &&
        isValidAsset(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().id == existing().id;

      allow delete: if isSignedIn() &&
        isValidId(assetId) &&
        existing().userId == request.auth.uid;
    }
  }
}
